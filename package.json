{
  "name": "rewardly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "wrap:icons": "node scripts/generate-app-icons.mjs && npx capacitor-assets generate --android --ios",
    "build:dist": "node scripts/generate-dist.mjs",
    "sync:version": "node scripts/sync-native-versions.mjs",
    "wrap:sync": "npm run wrap:icons && npm run sync:version && npx cap sync",
    "android": "npm run wrap:sync && npx cap open android",
    "android:build": "npm run wrap:sync && cd android && gradlew.bat assembleDebug",
    "ios": "npm run wrap:sync && npx cap open ios",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm run desktop:install && npm --prefix desktop run build:all",
    "desktop:build:win": "npm run desktop:install && npm --prefix desktop run build:win",
    "desktop:build:linux": "npm run desktop:install && npm --prefix desktop run build:linux",
    "desktop:build:mac": "npm run desktop:install && npm --prefix desktop run build:mac"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "@hookform/resolvers": "^5.5.7",
    "@lottiefiles/dotlottie-react": "^0.19.12",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
